{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "baseUrl": "../../motiv2d/frontend",
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true
  },
  "include": [
    "../../motiv2d/frontend/src/**/*.d.ts",
    "../../motiv2d/frontend/src/**/*.ts",
    "../../motiv2d/frontend/src/**/*.js",
    "../../motiv2d/frontend/src/**/*.svelte"
, "../../motiv2d/frontend/src/assets/images/lock-open.svg", "../../motiv2d/frontend/src/assets/images/lock.svg", "../../motiv2d/frontend/src/assets/images/folder.svg", "src/components/canvas/palce.md"  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
